      "structure_strength": "strong",
      "typical_slide_count": {"min": 6, "max": 10},
      "input_priority": {
        "outline_or_script": "user_structure_first",
        "no_outline_or_script": "offer_concise_or_deep_literature_report",
        "rule": "When the user supplies a page outline, speaking script, learning notes, or slide-by-slide plan, preserve that structure as the primary story contract and use the paper only to verify and source evidence."
      },
      "flow_options": [
        {
          "id": "paper_ppt_concise",
