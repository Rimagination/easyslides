            "max_micro_photo_group_items": 4,
            "source_figures_only": true,
            "a_class_low_resolution_action": "request_high_res_original"
          },
          "layout_policy": {
            "toc_required": true,
            "toc_top_level_sections": {"min": 4, "max": 7},
            "max_consecutive_identical_content_layouts": 3,
            "min_distinct_content_layouts_per_chapter": 2,
            "min_distinct_content_layouts": 4,
            "min_layout_diversity_ratio": 0.35,
            "layout_diversity_min_pages": 6
          },
          "content_quality_policy": {
            "required_structure": ["conclusion", "evidence", "explanation"],
            "min_evidence_blocks": 1,
            "min_source_text_chars": 80,
            "thin_severity": "warning",
            "placeholder_severity": "warning"
          },
          "visible_text_policy": {
            "banned_phrases": [
