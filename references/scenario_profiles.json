              "body": "#000000",
              "caption": "#000000",
              "table_text": "#000000",
              "secondary_text": "#333333",
              "accent": "#1C8B92",
              "light_border": "#C8D5E6",
              "page_background": "#FFFFFF",
              "panel_background": "#F5F6F8"
            }
          },
