      "slots": [
        {"slot_id": "title", "role": "title", "font_size_px": 34, "min_font_size_px": 30, "line_height": 1.2, "max_chars_per_line_zh": 20, "max_lines": 1, "required": true, "overflow_action": "shorten_title"},
        {"slot_id": "takeaway_title", "role": "card_title", "font_size_px": 21, "min_font_size_px": 18, "line_height": 1.2, "max_chars_per_line_zh": 14, "max_lines": 1, "repeated": true, "required": true, "overflow_action": "shorten_takeaway"},
        {"slot_id": "takeaway_body", "role": "body", "font_size_px": 16, "min_font_size_px": 14, "line_height": 1.25, "max_chars_per_line_zh": 28, "max_lines": 1, "repeated": true, "required": true, "overflow_action": "compress_body"},
        {"slot_id": "action", "role": "takeaway", "font_size_px": 18, "min_font_size_px": 15, "line_height": 1.2, "max_chars_per_line_zh": 20, "max_lines": 1, "required": false, "overflow_action": "move_to_speaker_notes"}
      ]
    }
  ]
}
