      "slots": [
        {"slot_id": "title", "role": "title", "font_size_px": 32, "min_font_size_px": 28, "line_height": 1.2, "max_chars_per_line_zh": 20, "max_lines": 1, "required": true, "overflow_action": "shorten_title"},
        {"slot_id": "node_title", "role": "card_title", "font_size_px": 20, "min_font_size_px": 17, "line_height": 1.2, "max_chars_per_line_zh": 5, "max_lines": 1, "repeated": true, "required": true, "overflow_action": "shorten_label"},
        {"slot_id": "node_body", "role": "card_body", "font_size_px": 22, "min_font_size_px": 18, "line_height": 1.25, "max_chars_per_line_zh": 6, "max_lines": 2, "repeated": true, "required": true, "overflow_action": "split_node_or_compress"},
        {"slot_id": "interpretation", "role": "takeaway", "font_size_px": 20, "min_font_size_px": 17, "line_height": 1.25, "max_chars_per_line_zh": 26, "max_lines": 2, "required": false, "overflow_action": "rewrite_as_takeaway"}
      ]
    },
    {
      "recipe_id": "pm_metric_dashboard",
      "name_zh": "指标仪表盘",
      "page_role": ["result", "dashboard", "finance", "metric"],
      "selection": {
        "content_shapes": ["metrics", "kpi", "dashboard"],
        "item_count_min": 2,
        "item_count_max": 6,
        "density": "high",
        "best_for": "Several numbers plus short interpretations.",
        "avoid_when": "The page needs a full chart with axes."
