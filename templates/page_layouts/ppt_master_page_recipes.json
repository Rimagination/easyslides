{
  "schema_version": "easyslides.ppt_master_page_recipes.v1",
  "canvas": {
    "width": 1280,
    "height": 720
  },
  "purpose": "Whole-page layout archetypes for PPT Master-compatible SVG execution. These recipes control page-level diversity; card recipes are nested inside assigned regions.",
  "recipes": [
    {
      "recipe_id": "pm_overview_mosaic",
      "name_zh": "总览马赛克",
      "page_role": ["overview", "executive_summary", "chapter_summary"],
      "selection": {
        "content_shapes": ["parallel_points", "summary", "argument_map"],
        "item_count_min": 3,
        "item_count_max": 6,
        "density": "medium",
        "best_for": "One governing conclusion with 3-6 supporting cards.",
        "avoid_when": "Each point needs paragraph-level evidence."
      },
      "layout_intent": "Use uneven card sizes and one highlighted synthesis band so the page does not become a flat grid.",
      "regions": [
        {"id": "header", "x": 64, "y": 42, "width": 760, "height": 72},
        {"id": "lead", "x": 72, "y": 132, "width": 520, "height": 92},
        {"id": "card_grid", "x": 72, "y": 245, "width": 1136, "height": 300},
        {"id": "synthesis_band", "x": 72, "y": 584, "width": 1136, "height": 72}
      ],
      "slots": [
        {"slot_id": "title", "role": "title", "font_size_px": 34, "min_font_size_px": 30, "line_height": 1.2, "max_chars_per_line_zh": 20, "max_lines": 1, "required": true, "overflow_action": "shorten_title_or_split_page"},
        {"slot_id": "lead", "role": "body", "font_size_px": 20, "min_font_size_px": 17, "line_height": 1.25, "max_chars_per_line_zh": 24, "max_lines": 2, "required": true, "overflow_action": "compress_to_claim"},
        {"slot_id": "card_title", "role": "card_title", "font_size_px": 20, "min_font_size_px": 17, "line_height": 1.2, "max_chars_per_line_zh": 7, "max_lines": 1, "repeated": true, "required": true, "overflow_action": "shorten_label"},
        {"slot_id": "card_body", "role": "card_body", "font_size_px": 18, "min_font_size_px": 15, "line_height": 1.25, "max_chars_per_line_zh": 8, "max_lines": 2, "repeated": true, "required": true, "overflow_action": "split_card_or_rewrite"},
        {"slot_id": "synthesis", "role": "takeaway", "font_size_px": 22, "min_font_size_px": 18, "line_height": 1.25, "max_chars_per_line_zh": 24, "max_lines": 2, "required": true, "overflow_action": "rewrite_as_short_takeaway"}
      ]
    },
    {
      "recipe_id": "pm_evidence_split",
      "name_zh": "左证据右解释",
      "page_role": ["evidence", "result", "case_study"],
      "selection": {
        "content_shapes": ["image_evidence", "figure_explanation", "result_interpretation"],
        "item_count_min": 2,
        "item_count_max": 4,
        "density": "medium",
        "best_for": "A source figure or image plus 2-4 explanation bullets.",
        "avoid_when": "The figure must occupy a full page."
      },
      "layout_intent": "Give evidence visual dominance and use a separate explanation rail with numbered claims.",
      "regions": [
        {"id": "image_area", "x": 70, "y": 150, "width": 560, "height": 410},
        {"id": "explanation_rail", "x": 685, "y": 150, "width": 525, "height": 410}
      ],
      "slots": [
        {"slot_id": "title", "role": "title", "font_size_px": 32, "min_font_size_px": 28, "line_height": 1.2, "max_chars_per_line_zh": 22, "max_lines": 1, "required": true, "overflow_action": "shorten_title"},
        {"slot_id": "image_caption", "role": "caption", "font_size_px": 15, "min_font_size_px": 13, "line_height": 1.25, "max_chars_per_line_zh": 22, "max_lines": 2, "required": false, "overflow_action": "move_to_notes"},
        {"slot_id": "claim_title", "role": "card_title", "font_size_px": 18, "min_font_size_px": 16, "line_height": 1.2, "max_chars_per_line_zh": 6, "max_lines": 1, "repeated": true, "required": true, "overflow_action": "shorten_label"},
