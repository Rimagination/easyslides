      "slots": [
        {"slot_id": "title", "role": "title", "font_size_px": 32, "min_font_size_px": 28, "line_height": 1.2, "max_chars_per_line_zh": 20, "max_lines": 1, "required": true, "overflow_action": "shorten_title"},
        {"slot_id": "step", "role": "card_title", "font_size_px": 18, "min_font_size_px": 15, "line_height": 1.2, "max_chars_per_line_zh": 6, "max_lines": 1, "repeated": true, "required": true, "overflow_action": "shorten_step"},
        {"slot_id": "step_detail", "role": "card_body", "font_size_px": 15, "min_font_size_px": 13, "line_height": 1.25, "max_chars_per_line_zh": 12, "max_lines": 2, "repeated": true, "required": true, "overflow_action": "compress_detail"},
        {"slot_id": "output", "role": "takeaway", "font_size_px": 18, "min_font_size_px": 15, "line_height": 1.25, "max_chars_per_line_zh": 28, "max_lines": 1, "required": false, "overflow_action": "move_to_notes"}
      ]
    },
    {
      "recipe_id": "pm_argument_stack",
      "name_zh": "论证堆叠",
      "page_role": ["argument", "background", "rationale"],
      "selection": {
        "content_shapes": ["argument", "claim_evidence_reasoning"],
        "item_count_min": 3,
        "item_count_max": 5,
        "density": "medium",
        "best_for": "Claim, evidence, reasoning, and implication hierarchy.",
        "avoid_when": "All items have equal importance."
      },
      "layout_intent": "Use a dominant claim block plus stacked evidence rows so the argument has hierarchy.",
      "regions": [
        {"id": "claim_block", "x": 75, "y": 150, "width": 460, "height": 410},
        {"id": "evidence_stack", "x": 585, "y": 150, "width": 625, "height": 410}
      ],
      "slots": [
        {"slot_id": "title", "role": "title", "font_size_px": 32, "min_font_size_px": 28, "line_height": 1.2, "max_chars_per_line_zh": 20, "max_lines": 1, "required": true, "overflow_action": "shorten_title"},
        {"slot_id": "claim", "role": "takeaway", "font_size_px": 24, "min_font_size_px": 20, "line_height": 1.25, "max_chars_per_line_zh": 14, "max_lines": 3, "required": true, "overflow_action": "rewrite_as_claim"},
        {"slot_id": "evidence_title", "role": "card_title", "font_size_px": 18, "min_font_size_px": 16, "line_height": 1.2, "max_chars_per_line_zh": 8, "max_lines": 1, "repeated": true, "required": true, "overflow_action": "shorten_label"},
        {"slot_id": "evidence_body", "role": "body", "font_size_px": 15, "min_font_size_px": 13, "line_height": 1.25, "max_chars_per_line_zh": 24, "max_lines": 2, "repeated": true, "required": true, "overflow_action": "compress_evidence"}
      ]
    },
    {
      "recipe_id": "pm_takeaway_panel",
      "name_zh": "结论建议面板",
      "page_role": ["conclusion", "recommendation", "summary"],
      "selection": {
        "content_shapes": ["takeaways", "recommendations", "summary_list"],
        "item_count_min": 3,
        "item_count_max": 5,
        "density": "low",
        "best_for": "A final slide with several short conclusions or actions.",
        "avoid_when": "The page needs to show evidence details."
