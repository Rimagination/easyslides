      "layout_intent": "Use one dominant metric, smaller secondary metrics, and an explanation panel to avoid equal-weight cards.",
      "regions": [
        {"id": "dominant_metric", "x": 70, "y": 155, "width": 380, "height": 230},
        {"id": "secondary_metrics", "x": 485, "y": 155, "width": 720, "height": 230},
        {"id": "explanation", "x": 70, "y": 420, "width": 1135, "height": 155}
