      "layout_intent": "Use node cards, connectors, and one lower interpretation band. Each node is a compact claim, not a paragraph.",
      "regions": [
        {"id": "chain", "x": 86, "y": 228, "width": 1108, "height": 215},
        {"id": "interpretation", "x": 86, "y": 500, "width": 1108, "height": 88}
