        {"slot_id": "axis_y", "role": "caption", "font_size_px": 14, "min_font_size_px": 12, "line_height": 1.2, "max_chars_per_line_zh": 10, "max_lines": 1, "required": true, "overflow_action": "shorten_axis_label"},
