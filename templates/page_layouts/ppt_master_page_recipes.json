      "layout_intent": "Use staggered stage blocks and connectors instead of same-size flat cards.",
      "regions": [
        {"id": "roadmap", "x": 80, "y": 210, "width": 1120, "height": 300},
        {"id": "risk_or_output", "x": 120, "y": 545, "width": 1040, "height": 62}
