        {"slot_id": "quadrant_body", "role": "card_body", "font_size_px": 17, "min_font_size_px": 15, "line_height": 1.25, "max_chars_per_line_zh": 10, "max_lines": 2, "repeated": true, "required": true, "overflow_action": "compress_or_split"}
      ]
    },
    {
      "recipe_id": "pm_process_roadmap",
      "name_zh": "路线流程图",
      "page_role": ["method", "roadmap", "workflow"],
      "selection": {
        "content_shapes": ["sequence", "process", "roadmap"],
        "item_count_min": 3,
        "item_count_max": 6,
        "density": "medium",
        "best_for": "Method, experiment, or implementation stages.",
        "avoid_when": "Stages have multiple nested substeps."
