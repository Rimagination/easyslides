      ]
    },
    {
      "recipe_id": "pm_causal_map",
      "name_zh": "机制因果图",
      "page_role": ["mechanism", "framework", "explanation"],
      "selection": {
        "content_shapes": ["causal_chain", "mechanism", "framework"],
        "item_count_min": 3,
        "item_count_max": 5,
        "density": "medium",
        "best_for": "A cause-process-response chain that must be read left to right.",
        "avoid_when": "Nodes require long paragraphs or dense equations."
