        {"slot_id": "interpretation", "role": "body", "font_size_px": 17, "min_font_size_px": 15, "line_height": 1.25, "max_chars_per_line_zh": 24, "max_lines": 3, "required": true, "overflow_action": "compress_or_split"}
      ]
    },
    {
      "recipe_id": "pm_comparison_matrix",
      "name_zh": "四象限比较",
      "page_role": ["comparison", "decision", "classification"],
      "selection": {
        "content_shapes": ["matrix", "comparison", "quadrant"],
        "item_count_min": 4,
        "item_count_max": 4,
        "density": "medium",
        "best_for": "Four options or categories compared by two axes.",
        "avoid_when": "More than four categories are required."
