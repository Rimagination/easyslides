      "role": "cover",
      "slots": [
        "LOGO",
        "TITLE",
        "SUBTITLE",
        "AUTHOR",
        "ADVISOR",
        "INSTITUTION",
        "DATE"
      ]
    },
    {
      "page_id": "toc",
      "svg_path": "02_toc.svg",
      "role": "toc",
      "slots": [
        "LOGO",
        "TOC_ITEM_1_TITLE",
        "TOC_ITEM_2_TITLE",
        "TOC_ITEM_3_TITLE",
        "TOC_ITEM_4_TITLE",
        "TOC_ITEM_5_TITLE",
        "TOC_ITEM_6_TITLE",
        "TOC_ITEM_1_DESC",
        "TOC_ITEM_2_DESC",
        "TOC_ITEM_3_DESC",
        "TOC_ITEM_4_DESC",
