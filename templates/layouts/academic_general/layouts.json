        "TITLE"
      ]
    },
    {
      "page_id": "content",
      "svg_path": "03_content.svg",
      "role": "content",
      "page_archetype": "bounded_component_composition",
      "content_shell_policy": "template_component_composition_required",
      "body_variants": [
        "figure_evidence",
        "comparison_synthesis",
        "process_outcome",
        "metrics_evidence",
        "evidence_argument",
        "table_decision",
        "open_component_composition"
      ],
      "regions": [
        {
          "region_id": "running_title",
          "frame": {"x": 0, "y": 0, "width": 1280, "height": 70},
          "z_index": 0
        },
        {
          "region_id": "central_message",
          "frame": {"x": 0, "y": 70, "width": 1280, "height": 50},
          "z_index": 1,
          "purpose": "central_message_only"
        },
        {
          "region_id": "body_canvas",
          "frame": {"x": 52, "y": 135, "width": 1176, "height": 515},
          "z_index": 10,
          "fit": "contain",
          "purpose": "template_local_component_composition_only"
        },
        {
          "region_id": "footer",
          "frame": {"x": 0, "y": 665, "width": 1280, "height": 55},
          "z_index": 1
        }
      ],
      "body_canvas": {"x": 52, "y": 135, "width": 1176, "height": 515},
      "slots": [
        "SECTION_NUM",
        "PAGE_TITLE",
        "LOGO",
        "KEY_MESSAGE",
        "SOURCE",
        "SECTION_NAME",
        "PAGE_NUM"
      ]
    },
    {
      "page_id": "ending",
      "svg_path": "04_ending.svg",
      "role": "ending",
