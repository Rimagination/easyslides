{
  "schema_version": "easyslides.template_slot_contracts.v1",
  "template_id": "research_core",
  "replacement_rule": "replace_declared_slots_preserve_template_geometry",
  "text_fit_policy": {
    "overflow_strategy_order": [
      "choose_declared_scene",
      "split_content",
      "shorten_within_capacity"
    ]
  },
  "layouts": [
    {
      "layout_id": "cover",
      "slots": [
        "TITLE",
        "SUBTITLE",
        "PRESENTER"
      ]
    },
    {
      "layout_id": "toc",
      "slots": [
        "PAGE_TITLE",
        "SECTION_01",
        "SECTION_02",
        "SECTION_03"
      ]
    },
    {
      "layout_id": "chapter",
      "slots": [
        "CHAPTER_NO",
        "CHAPTER_TITLE"
      ]
    },
    {
      "layout_id": "content",
      "slots": [
        "PAGE_TITLE",
        "KEY_MESSAGE",
        "PAGE_NUMBER"
      ]
    },
    {
      "layout_id": "ending",
      "slots": [
        "CLOSING",
        "SUBTITLE"
      ]
    }
  ]
}
